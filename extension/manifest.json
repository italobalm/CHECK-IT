{
    "manifest_version": 3,
    "name": "Check It",
    "description": "Extensão para avaliar a credibilidade de notícias e informações online.",
    "version": "1.0.0",

    "icons": {
    "16": "public/icons/icon16.png",
    "32": "public/icons/icon32.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
    },


    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],

"host_permissions": [
    "https://*/*",
    "http://localhost:3000/*"
],

  "background": {
    "service_worker": "src/background/background.js"
  },


    "content_scripts": [
        {
            "matches": ["https://*/*"],
            "js": [
                "src/ui/semaforo.js",
                "src/content/content.js"],
            "css": ["src/ui/semaforo.css"],
            "run_at": "document_idle"
        }
    ]
}